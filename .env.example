# ==============================================================================
# BruteShield — Production Environment Configuration Template
# ==============================================================================
#
# INSTRUCTIONS:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Replace every <PLACEHOLDER> value with a real secret.
#   3. NEVER commit .env to version control.
#
# In production mode (BRUTESHIELD_ENV=production), the application will
# refuse to start if SECRET_KEY or VAULT_KEY still contain their default
# demo values. This is enforced at import time in bruteshield/config.py.
#
# ==============================================================================

# --- Application Environment ---
# 'development' | 'testing' | 'production'
BRUTESHIELD_ENV=development

# --- Session Secret Key ---
# Must be cryptographically random, at least 32 bytes (64 hex characters).
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
BRUTESHIELD_SECRET_KEY=<GENERATE_WITH_secrets.token_hex(32)>

# --- AES-256-GCM Vault Master Key ---
# Must be exactly 32 bytes when UTF-8 encoded.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32)[:32])"
#
# WARNING: Changing this key after vault entries have been stored will make
# those entries permanently unreadable. Back up the key securely.
BRUTESHIELD_VAULT_KEY=<GENERATE_WITH_secrets.token_urlsafe(32)[:32]>

# --- Network Binding ---
# Default binds to localhost only. Use 127.0.0.1 for local access.
# When deployed behind a reverse proxy, keep 127.0.0.1.
BRUTESHIELD_HOST=127.0.0.1
BRUTESHIELD_PORT=5000

# --- WSGI Server Tuning ---
# Waitress (Windows): number of worker threads
WAITRESS_THREADS=4
# Gunicorn (Linux): number of worker processes
GUNICORN_WORKERS=2

# --- Database ---
BRUTESHIELD_DB_PATH=logs/bruteshield.db

# --- ML Model ---
BRUTESHIELD_MODEL_PATH=trained_model.pkl

# --- Threat Detection Tuning ---
MAX_FAILED_ATTEMPTS=5
TIME_WINDOW_SECONDS=60
CAPTCHA_SCORE_LIMIT=0.06
SLIDING_WINDOW_SECONDS=900

# --- Session Cookie Security ---
# SESSION_COOKIE_SECURE is automatically set to True when BRUTESHIELD_ENV=production.
# SESSION_COOKIE_HTTPONLY and SESSION_COOKIE_SAMESITE are hardcoded (True, Lax).

# --- Trusted Reverse Proxy IPs ---
# Comma-separated list. X-Forwarded-For is honoured ONLY when the direct
# peer address is in this list. Do not add untrusted addresses.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Default Accounts (Demo / Development Only) ---
# In production, consider disabling automatic account seeding entirely
# or changing these to strong, unique values.
DEFAULT_ADMIN_USER=dashadmin
DEFAULT_ADMIN_PASS=<SET_STRONG_ADMIN_PASSWORD>
DEFAULT_DEMO_USER=admin
DEFAULT_DEMO_PASS=<SET_STRONG_DEMO_PASSWORD>

# ==============================================================================
# Key Rotation Procedure:
#
# 1. BRUTESHIELD_SECRET_KEY rotation:
#    - Generate new key: python -c "import secrets; print(secrets.token_hex(32))"
#    - Update .env with new key.
#    - Restart the application. All existing sessions will be invalidated.
#
# 2. BRUTESHIELD_VAULT_KEY rotation:
#    - Export all vault entries using the current key (decrypt).
#    - Update .env with new vault key.
#    - Re-encrypt and re-import vault entries with the new key.
#    - WARNING: Without export/re-import, existing vault entries become
#      permanently unreadable.
# ==============================================================================

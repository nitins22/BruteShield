# ==============================================================================
# BruteShield - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set environment variables before deploying to production.
# In 'production' mode, non-default BRUTESHIELD_SECRET_KEY and BRUTESHIELD_VAULT_KEY
# are strictly enforced at startup.
# ==============================================================================

# Application Environment ('production' | 'development' | 'testing')
BRUTESHIELD_ENV=production

# Session secret key (minimum 32 bytes / 64 hex characters)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
BRUTESHIELD_SECRET_KEY=b7f8c92a4e1d3f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a

# AES-256-GCM vault master key (32 bytes)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32)[:32])"
BRUTESHIELD_VAULT_KEY=v8k2P9xL4mN7qR1tW5yB3cD6fG8jH0zM

# Network Binding
BRUTESHIELD_HOST=127.0.0.1
BRUTESHIELD_PORT=5000
WAITRESS_THREADS=8

# Database and Model Locations
BRUTESHIELD_DB_PATH=logs/bruteshield.db
BRUTESHIELD_MODEL_PATH=trained_model.pkl

# Adaptive Defense Tuning
MAX_FAILED_ATTEMPTS=5
TIME_WINDOW_SECONDS=60
CAPTCHA_SCORE_LIMIT=0.06
SLIDING_WINDOW_SECONDS=900

# Trusted Reverse Proxy IPs (comma separated)
TRUSTED_PROXIES=127.0.0.1,::1

# Default Credentials
DEFAULT_ADMIN_USER=dashadmin
DEFAULT_ADMIN_PASS=Dash@Admin1
DEFAULT_DEMO_USER=admin
DEFAULT_DEMO_PASS=Secure@123
